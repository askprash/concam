# Large binary data arrays (calibration, numpy dumps). The OCR templates are the
# one tracked .npz — keep it.
*.npz
!concam/ocr/templates.npz

# Tabular dumps that scripts emit into the working tree
*.csv

# Credentials — must never be committed (managed on the server, see docs/public_labeler.md)
credentials.txt
.htpasswd

# Internal AI-agent harness (kept on disk for local use, not shared)
.ralph/
ralph-once.sh
!configs/static_mask_mit_green_building.npz
